# =============================================
# CareerOS â€” Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# =============================================

# â”€â”€ DATABASE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DATABASE_URL="postgresql://careeros:password@localhost:5432/careeros_dev"

# â”€â”€ AUTHENTICATION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
JWT_SECRET="change-this-to-a-long-random-secret-at-least-64-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-this-to-another-long-random-secret"
JWT_REFRESH_EXPIRES_IN="30d"
BCRYPT_ROUNDS=12

# â”€â”€ SERVER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# â”€â”€ REDIS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
REDIS_URL="redis://localhost:6379"

# â”€â”€ AI (OpenAI compatible) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Powered by Anthropic Claude (get a key at console.anthropic.com)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...your-key-here...
AI_MODEL=claude-opus-5-5
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
# Optional: per-user monthly token budget
AI_MONTHLY_BUDGET_TOKENS=500000

# â”€â”€ EMAIL (SMTP) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM="CareerOS <noreply@careeros.app>"

# â”€â”€ FILE STORAGE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Options: local | s3 | r2
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# For S3/R2:
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=    # For R2: https://accountid.r2.cloudflarestorage.com

# â”€â”€ JOB SOURCES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Add API keys for job sources you have legitimate access to
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# INDEED_PUBLISHER_KEY=
# REMOTIVE_API_KEY=

# â”€â”€ APP â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
APP_NAME="CareerOS"
APP_URL=http://localhost:5173
DEMO_MODE=false

# â”€â”€ RATE LIMITING â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_PER_MINUTE=20

# â”€â”€ LOGGING â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
LOG_LEVEL=info
LOG_FORMAT=pretty

# Or use NVIDIA NIM (free dev credits at build.nvidia.com): set AI_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-...your-key-here...
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
