# CareerOS configuration. Copy to .env (local) or .env.production (server) and fill in.
# Lines marked REQUIRED must be set. Never commit the real file.

# ── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# REQUIRED. Local default matches docker-compose.yml
DATABASE_URL=postgresql://careeros:careeros_dev_password@localhost:5432/careeros_dev
# Needed by the background worker (reminders, scheduled job fetches)
REDIS_URL=redis://localhost:6379

# REQUIRED. Two different random strings of 32+ characters. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Where the web app runs (used in email links) and which browser origins may call the API
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Reverse proxies in front of the API (nginx = 1, Caddy + nginx = 2)
TRUST_PROXY=1

# ── Database for docker compose (only read by docker-compose*.yml) ─────────
POSTGRES_DB=careeros_dev
POSTGRES_USER=careeros
# REQUIRED in production: a long random password
POSTGRES_PASSWORD=careeros_dev_password
# Production only: your domain, e.g. careeros.example.com (Caddy gets the HTTPS certificate)
DOMAIN=

# ── AI ─────────────────────────────────────────────────────────────────────
# 'anthropic' (Claude) or 'nvidia' (NVIDIA NIM, OpenAI-compatible, free developer credits)
AI_PROVIDER=anthropic
# Anthropic key from console.anthropic.com (starts with sk-ant-)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# NVIDIA key from build.nvidia.com (starts with nvapi-), used when AI_PROVIDER=nvidia
NVIDIA_API_KEY=
# meta/llama-3.3-70b-instruct was retired (HTTP 410); check build.nvidia.com for current ids
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
AI_MAX_TOKENS=4096
AI_AGENT_MAX_STEPS=8
# Per-user monthly token budget
AI_MONTHLY_BUDGET_TOKENS=500000
AI_RATE_LIMIT_PER_MINUTE=20
# Optional second provider used when the first is unreachable or overloaded: anthropic | nvidia | none
# (its key must be set too). Never used for auth or model errors, which need fixing instead.
AI_FALLBACK_PROVIDER=none
# Per-attempt timeout and retries (exponential backoff) for 429 / 5xx / network failures
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=2

# ── Email (password reset, email confirmation, reminders) ──────────────────
# Local development: run `docker compose up -d mailpit` and read mail at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=CareerOS <noreply@careeros.app>
# Production example (Gmail needs an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=you@gmail.com  SMTP_PASSWORD=app-password

# ── Resume file storage ────────────────────────────────────────────────────
# local = files on this server's disk; s3 / r2 = an S3-compatible bucket (recommended in production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com   (leave empty for AWS S3)
S3_ENDPOINT=

# ── Job sources ────────────────────────────────────────────────────────────
# Optional: free keys from developer.adzuna.com turn on "Adzuna India"
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Monitoring ─────────────────────────────────────────────────────────────
# Optional error reporting. API DSN here; web DSN is a build argument (VITE_SENTRY_DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=

# ── Misc ───────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
# Per client IP per window. One page load makes 6-10 requests; auth and AI have stricter limits
RATE_LIMIT_MAX_REQUESTS=1000
LOG_LEVEL=info
# pretty for local, json for production log collectors
LOG_FORMAT=pretty
# Timezone for the worker's daily schedule (reminders 9:00, cleanup 3:30)
SCHEDULER_TZ=Asia/Kolkata
APP_NAME=CareerOS
DEMO_MODE=false
